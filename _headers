# HTML: bewusst frisch laden, damit Bestell-App-Updates sofort greifen
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/app/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Bild-Assets: Dateinamen enthalten einen Content-Hash; deshalb langfristig sicher cachebar
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

# Stabiles Favicon für Browser und Suchergebnisse
/favicon.ico
  Cache-Control: public, max-age=604800

# Ratgeber-/SEO-Seiten: schnell, aber regelmäßig aktualisierbar
/fotoabzuege-vom-handy/*
  Cache-Control: public, max-age=300, s-maxage=3600
/fotoabzuege-10x15/*
  Cache-Control: public, max-age=300, s-maxage=3600
/fotoabzuege-matt-oder-glaenzend/*
  Cache-Control: public, max-age=300, s-maxage=3600
/smartphone-fotos-ohne-beschnitt/*
  Cache-Control: public, max-age=300, s-maxage=3600
/fotoabzuege-haigerloch/*
  Cache-Control: public, max-age=300, s-maxage=3600
